{
  "name": "homefax",
  "private": true,
  "version": "1.0.0",
  "description": "HomeFAX — the permanent record of how a home was built. Contractor, homeowner, and institution apps over one secured database.",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:contractor": "npm run dev -w @homefax/contractor",
    "dev:homeowner": "npm run dev -w @homefax/homeowner",
    "dev:admin": "npm run dev -w @homefax/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate -w @homefax/db",
    "db:seed": "npm run seed -w @homefax/db",
    "db:import-legacy": "npm run import-legacy -w @homefax/db"
  },
  "engines": { "node": ">=22" }
}
