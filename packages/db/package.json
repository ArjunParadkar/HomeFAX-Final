{
  "name": "@homefax/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HomeFAX database: schema, migrations, row-level security, repositories, stats, seed.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "import-legacy": "tsx scripts/import-legacy.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@homefax/auth": "*",
    "@homefax/core": "*",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.1.16",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "tsx": "^4.23.12",
    "drizzle-kit": "^0.31.10"
  }
}
